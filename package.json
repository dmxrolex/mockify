{
  "name": "styleit-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "node --check worker.js && node --check telegram.js && node --check render.js && node --check media.js && node --check project.js && node --check exports.js && vite build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "fflate": "0.8.2",
    "input-switch-polyfill": "^1.12.0",
    "lottie-web": "^5.13.0",
    "mediabunny": "^1.66.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "vite": "^7.3.0",
    "wrangler": "4.166.0"
  }
}
